# Django Configuration
DJANGO_SECRET_KEY=django-insecure-your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database
# For SQLite (development):
DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/brilliantafrica

# Google Generative AI (Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GENAI_MODEL=gemini-2.0-flash

# Africa's Talking API (USSD/SMS)
AFRICASTALKING_SANDBOX_USERNAME=sandbox
AFRICASTALKING_SANDBOX_API_KEY=your-sandbox-api-key-here
AFRICASTALKING_LIVE_USERNAME=your-live-username
AFRICASTALKING_LIVE_API_KEY=your-live-api-key

# M-Pesa Configuration
MPESA_SHORTCODE=174379
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret

# Flutterwave API
FLUTTERWAVE_API_KEY=your-flutterwave-api-key
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key
FLUTTERWAVE_WEBHOOK_SECRET=your-webhook-secret

# Stripe API
STRIPE_API_KEY=your-stripe-api-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# PayPal Configuration
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox  # Change to live in production

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# SendGrid (Alternative Email Provider)
SENDGRID_API_KEY=your-sendgrid-api-key

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,https://yourdomain.com

# Redis/Caching
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# Celery Configuration (for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Sentry Error Tracking
SENTRY_DSN=your-sentry-dsn-url

# AWS S3 Configuration (for static files/media)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# Analytics
MIXPANEL_TOKEN=your-mixpanel-token
GOOGLE_ANALYTICS_ID=your-ga-id

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/brilliant/app.log

# Payment Settings
SUBSCRIPTION_DURATION_DAYS=30
PAYMENT_WEBHOOK_SECRET=your-webhook-secret
PAYMENT_TIMEOUT_SECONDS=30

# Feature Flags
ENABLE_TEACHER_REGISTRATION=True
ENABLE_PARENT_FEATURES=True
ENABLE_SCHOOL_ADMIN=True
ENABLE_OFFLINE_MODE=False

# Webhook URLs
PAYMENT_WEBHOOK_URL=https://yourdomain.com/webhooks/payment/
USSD_WEBHOOK_URL=https://yourdomain.com/webhooks/ussd/
SMS_WEBHOOK_URL=https://yourdomain.com/webhooks/sms/

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600  # seconds

# AI Settings
MAX_AI_RESPONSE_LENGTH=1000
AI_RESPONSE_TIMEOUT=30
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=500

# Security
SECURE_SSL_REDIRECT=False  # Set to True in production
SESSION_COOKIE_SECURE=False  # Set to True in production
CSRF_COOKIE_SECURE=False  # Set to True in production
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Social Authentication (Optional)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Twilio (SMS Alternative)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Timezone
TIME_ZONE=UTC

# Language
LANGUAGE_CODE=en-us

# Monitoring
NEW_RELIC_CONFIG_FILE=newrelic.ini
NEW_RELIC_ENVIRONMENT=development
